{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/mobile", "destination": "/mobile.html" },
    { "source": "/mobile.html", "destination": "/mobile.html" },
    { "source": "/chicken-management", "destination": "/chicken-management/index.html" },
    { "source": "/chicken-management/(.*)", "destination": "/chicken-management/index.html" },
    { "source": "/chiken-mangement", "destination": "/chiken-mangement/index.html" },
    { "source": "/chiken-mangement/(.*)", "destination": "/chiken-mangement/index.html" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
